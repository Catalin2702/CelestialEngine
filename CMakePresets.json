{
	"version": 10,
	"cmakeMinimumRequired": {
		"major": 4,
		"minor": 1,
		"patch": 0
	},
	"$comment": [
		"Module: CelestialEngine",
		"File: CMakePresets.json",
		"Created by: Catalin Chirosca",
		"Created: 2026-08-13",
		"Updated by: Catalin Chirosca",
		"Updated: 2026-08-18",
		"",
		"All generators are multi-config, so the build type lives in the build/test presets",
		"(via 'configuration') instead of in a configure preset per type. That keeps the",
		"number of visible configure presets down to one per toolchain: CMake forbids a",
		"build preset from referencing a hidden configure preset, so trimming the list is",
		"the only way to keep the IDE preset picker readable."
	],
	"configurePresets": [
		{
			"name": "config-preset-base",
			"hidden": true,
			"binaryDir": "${sourceDir}/.build/${presetName}",
			"toolchainFile": "$env{CMAKE_TOOLCHAIN_FILE}",
			"cacheVariables": {
				"VCPKG_MANIFEST_MODE": "ON",
				"CMAKE_CONFIGURATION_TYPES": "Debug;Release;Dist"
			}
		},
		{
			"name": "config-preset-ninja-multi",
			"hidden": true,
			"inherits": "config-preset-base",
			"generator": "Ninja Multi-Config"
		},
		{
			"name": "config-preset-clang",
			"displayName": "Config-Preset Clang",
			"inherits": "config-preset-ninja-multi",
			"binaryDir": "${sourceDir}/.build/clang",
			"condition": {
				"type": "allOf",
				"conditions": [
					{
						"type": "notEquals",
						"lhs": "$env{CLANG_CMAKE_C_COMPILER}",
						"rhs": ""
					},
					{
						"type": "notEquals",
						"lhs": "$env{CLANG_CMAKE_CXX_COMPILER}",
						"rhs": ""
					}
				]
			},
			"cacheVariables": {
				"CMAKE_C_COMPILER": "$env{CLANG_CMAKE_C_COMPILER}",
				"CMAKE_CXX_COMPILER": "$env{CLANG_CMAKE_CXX_COMPILER}",
				"CE_TOOLCHAIN_NAME": "Clang"
			}
		},
		{
			"name": "config-preset-appleclang",
			"displayName": "Config-Preset AppleClang",
			"inherits": "config-preset-ninja-multi",
			"binaryDir": "${sourceDir}/.build/appleclang",
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Darwin"
			},
			"cacheVariables": {
				"CMAKE_C_COMPILER": "/usr/bin/clang",
				"CMAKE_CXX_COMPILER": "/usr/bin/clang++",
				"CE_TOOLCHAIN_NAME": "AppleClang"
			}
		},
		{
			"name": "config-preset-xcode",
			"displayName": "Config-Preset Xcode",
			"inherits": "config-preset-base",
			"generator": "Xcode",
			"binaryDir": "${sourceDir}/.build/xcode",
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Darwin"
			},
			"cacheVariables": {
				"VCPKG_TARGET_TRIPLET": "arm64-osx",
				"CE_TOOLCHAIN_NAME": "Xcode"
			}
		},
		{
			"name": "config-preset-vs",
			"displayName": "Config-Preset Visual Studio",
			"inherits": "config-preset-base",
			"generator": "Visual Studio 17 2022",
			"binaryDir": "${sourceDir}/.build/vs",
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Windows"
			},
			"cacheVariables": {
				"CE_TOOLCHAIN_NAME": "VisualStudio"
			}
		}
	],
	"buildPresets": [
		{
			"name": "build-preset-base",
			"hidden": true
		},
		{
			"name": "build-preset-clang-multi",
			"displayName": "Build-Preset Clang-Multi",
			"inherits": "build-preset-base",
			"configurePreset": "config-preset-clang"
		},
		{
			"name": "build-preset-appleclang-multi",
			"displayName": "Build-Preset AppleClang-Multi",
			"inherits": "build-preset-base",
			"configurePreset": "config-preset-appleclang"
		},
		{
			"name": "build-preset-xcode-multi",
			"displayName": "Build-Preset Xcode-Multi",
			"inherits": "build-preset-base",
			"configurePreset": "config-preset-xcode"
		},
		{
			"name": "build-preset-vs-multi",
			"displayName": "Build-Preset VS-Multi",
			"inherits": "build-preset-base",
			"configurePreset": "config-preset-vs"
		}
	],
	"testPresets": [
		{
			"name": "test-preset-base",
			"hidden": true,
			"output": {
				"outputOnFailure": true
			},
			"execution": {
				"noTestsAction": "error",
				"stopOnFailure": false
			}
		},
		{
			"name": "test-preset-clang-multi",
			"displayName": "Test-Preset Clang-Multi",
			"inherits": "test-preset-base",
			"configurePreset": "config-preset-clang"
		},
		{
			"name": "test-preset-appleclang-multi",
			"displayName": "Test-Preset AppleClang-Multi",
			"inherits": "test-preset-base",
			"configurePreset": "config-preset-appleclang"
		},
		{
			"name": "test-preset-xcode-multi",
			"displayName": "Test-Preset Xcode-Multi",
			"inherits": "test-preset-base",
			"configurePreset": "config-preset-xcode"
		},
		{
			"name": "test-preset-vs-multi",
			"displayName": "Test-Preset VS-Multi",
			"inherits": "test-preset-base",
			"configurePreset": "config-preset-vs"
		}
	]
}

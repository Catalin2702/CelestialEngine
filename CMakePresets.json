{
	"version": 10,
	"cmakeMinimumRequired": {
		"major": 4,
		"minor": 1,
		"patch": 0
	},
	"$comment": [
		"Module: CelestialEngine",
		"File: CMakePresets.json",
		"Created by: Catalin Chirosca",
		"Created: 2026-08-13",
		"Updated by: Catalin Chirosca",
		"Updated: 2026-08-17"
	],
	"configurePresets": [
		{
			"name": "config-preset-base",
			"hidden": true,
			"binaryDir": "${sourceDir}/.build/${presetName}",
			"toolchainFile": "$env{CMAKE_TOOLCHAIN_FILE}",
			"cacheVariables": {
				"VCPKG_MANIFEST_MODE": "ON"
			}
		},
		{
			"name": "config-preset-clang",
			"hidden": true,
			"inherits": "config-preset-base",
			"generator": "Ninja",
			"cacheVariables": {
				"CMAKE_C_COMPILER": "$env{CLANG_CMAKE_C_COMPILER}",
				"CMAKE_CXX_COMPILER": "$env{CLANG_CMAKE_CXX_COMPILER}"
			}
		},
		{
			"name": "config-preset-appleclang",
			"hidden": true,
			"inherits": "config-preset-base",
			"generator": "Ninja",
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Darwin"
			},
			"cacheVariables": {
				"CMAKE_C_COMPILER": "/usr/bin/clang",
				"CMAKE_CXX_COMPILER": "/usr/bin/clang++"
			}
		},
		{
			"name": "config-preset-xcode-multi",
			"displayName": "Config-Preset Xcode-Multi",
			"inherits": "config-preset-base",
			"generator": "Xcode",
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Darwin"
			},
			"cacheVariables": {
				"CMAKE_CONFIGURATION_TYPES": "Debug;Release;Dist",
				"VCPKG_TARGET_TRIPLET": "arm64-osx"
			}
		},
		{
			"name": "config-preset-clang-debug",
			"displayName": "Config-Preset Clang-Debug",
			"inherits": "config-preset-clang",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug"
			}
		},
		{
			"name": "config-preset-clang-release",
			"displayName": "Config-Preset Clang-Release",
			"inherits": "config-preset-clang",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release"
			}
		},
		{
			"name": "config-preset-clang-dist",
			"displayName": "Config-Preset Clang-Dist",
			"inherits": "config-preset-clang",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Dist"
			}
		},
		{
			"name": "config-preset-appleclang-debug",
			"displayName": "Config-Preset AppleClang-Debug",
			"inherits": "config-preset-appleclang",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug"
			}
		},
		{
			"name": "config-preset-appleclang-release",
			"displayName": "Config-Preset AppleClang-Release",
			"inherits": "config-preset-appleclang",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release"
			}
		},
		{
			"name": "config-preset-appleclang-dist",
			"displayName": "Config-Preset AppleClang-Dist",
			"inherits": "config-preset-appleclang",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Dist"
			}
		}
	],
	"buildPresets": [
		{
			"name": "build-preset-base",
			"hidden": true
		},
		{
			"name": "build-preset-clang-debug",
			"displayName": "Build-Preset Clang-Debug",
			"inherits": "build-preset-base",
			"configurePreset": "config-preset-clang-debug"
		},
		{
			"name": "build-preset-clang-release",
			"displayName": "Build-Preset Clang-Release",
			"inherits": "build-preset-base",
			"configurePreset": "config-preset-clang-release"
		},
		{
			"name": "build-preset-clang-dist",
			"displayName": "Build-Preset Clang-Dist",
			"inherits": "build-preset-base",
			"configurePreset": "config-preset-clang-dist"
		},
		{
			"name": "build-preset-appleclang-debug",
			"displayName": "Build-Preset AppleClang-Debug",
			"inherits": "build-preset-base",
			"configurePreset": "config-preset-appleclang-debug"
		},
		{
			"name": "build-preset-appleclang-release",
			"displayName": "Build-Preset AppleClang-Release",
			"inherits": "build-preset-base",
			"configurePreset": "config-preset-appleclang-release"
		},
		{
			"name": "build-preset-appleclang-dist",
			"displayName": "Build-Preset AppleClang-Dist",
			"inherits": "build-preset-base",
			"configurePreset": "config-preset-appleclang-dist"
		},
		{
			"name": "build-preset-xcode-debug",
			"displayName": "Build-Preset Xcode-Debug",
			"inherits": "build-preset-base",
			"configurePreset": "config-preset-xcode-multi",
			"configuration": "Debug"
		},
		{
			"name": "build-preset-xcode-release",
			"displayName": "Build-Preset Xcode-Release",
			"inherits": "build-preset-base",
			"configurePreset": "config-preset-xcode-multi",
			"configuration": "Release"
		},
		{
			"name": "build-preset-xcodedist",
			"displayName": "Build-Preset Xcode-Dist",
			"inherits": "build-preset-base",
			"configurePreset": "config-preset-xcode-multi",
			"configuration": "Dist"
		}
	],
	"testPresets": [
		{
			"name": "base-test-preset",
			"hidden": true,
			"output": {
				"outputOnFailure": true
			},
			"execution": {
				"noTestsAction": "error",
				"stopOnFailure": false
			}
		},
		{
			"name": "test-preset-clang-debug",
			"displayName": "Test-Preset Clang-Debug",
			"inherits": "base-test-preset",
			"configurePreset": "config-preset-clang-debug"
		},
		{
			"name": "test-preset-clang-release",
			"displayName": "Test-Preset Clang-Release",
			"inherits": "base-test-preset",
			"configurePreset": "config-preset-clang-release"
		},
		{
			"name": "test-preset-clang-dist",
			"displayName": "Test-Preset Clang-Dist",
			"inherits": "base-test-preset",
			"configurePreset": "config-preset-clang-dist"
		},
		{
			"name": "test-preset-appleclang-debug",
			"displayName": "Test-Preset AppleClang-Debug",
			"inherits": "base-test-preset",
			"configurePreset": "config-preset-appleclang-debug"
		},
		{
			"name": "test-preset-appleclang-release",
			"displayName": "Test-Preset AppleClang-Release",
			"inherits": "base-test-preset",
			"configurePreset": "config-preset-appleclang-release"
		},
		{
			"name": "test-preset-appleclang-dist",
			"displayName": "Test-Preset AppleClang-Dist",
			"inherits": "base-test-preset",
			"configurePreset": "config-preset-appleclang-dist"
		},
		{
			"name": "test-preset-xcode-debug",
			"displayName": "Test-Preset Xcode-Debug",
			"inherits": "base-test-preset",
			"configurePreset": "config-preset-xcode-multi",
			"configuration": "Debug"
		},
		{
			"name": "test-preset-xcode-release",
			"displayName": "Test-Preset Xcode-Release",
			"inherits": "base-test-preset",
			"configurePreset": "config-preset-xcode-multi",
			"configuration": "Release"
		},
		{
			"name": "test-preset-xcode-dist",
			"displayName": "Test-Preset Xcode-Dist",
			"inherits": "base-test-preset",
			"configurePreset": "config-preset-xcode-multi",
			"configuration": "Dist"
		}
	]
}
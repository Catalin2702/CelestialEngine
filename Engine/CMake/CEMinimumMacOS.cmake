# The oldest macOS the engine and its applications run on, written ONCE, here, as CMAKE_OSX_DEPLOYMENT_TARGET:
#   - CMake compiles and links every target for it (-mmacosx-version-min; MACOSX_DEPLOYMENT_TARGET under Xcode);
#   - ce_configure_application reads it for LSMinimumSystemVersion (Info.plist) and actool;
#   - Engine/Shaders reads it for xcrun metal;
#   - the vcpkg dependencies are built for it, through the overlay triplet written below.
# Override with -DCMAKE_OSX_DEPLOYMENT_TARGET=<version>.
#
# Included by the top-level CMakeLists.txt BEFORE project(): project() configures the compilers from the variable and
# runs vcpkg install, which reads the overlay triplet. So the OS comes from CMAKE_HOST_* (APPLE is not set yet).

include_guard(GLOBAL)

if (NOT CMAKE_HOST_APPLE)
	return()
endif ()

set(CE_DEFAULT_MINIMUM_MACOS "27.0")

# Filled in when empty, not only when undefined: project() caches the variable empty, so a plain CACHE default would
# never reach a build tree configured before this file existed.
if (NOT CMAKE_OSX_DEPLOYMENT_TARGET)
	set(CMAKE_OSX_DEPLOYMENT_TARGET "${CE_DEFAULT_MINIMUM_MACOS}" CACHE STRING
		"Minimum macOS version the engine and its applications run on" FORCE)
endif ()

# vcpkg builds its ports with the triplet's VCPKG_OSX_DEPLOYMENT_TARGET and, without one, for the macOS of the machine
# that builds them (27.2 here): every link of a static dependency into a 27.0 target then warns "built for newer macOS
# version". The built-in triplet sets none, so an overlay with the SAME name (it shadows the built-in one) is generated
# into the build tree from the variable above. The triplet file is part of each package's ABI hash, so changing the
# minimum rebuilds the dependencies instead of reusing binaries built for another one.
# CMAKE_HOST_SYSTEM_PROCESSOR is only filled in by project(): ask the host directly.
cmake_host_system_information(RESULT _ce_host_arch QUERY OS_PLATFORM)
if (_ce_host_arch MATCHES "^(arm64|aarch64)$")
	set(_ce_vcpkg_arch arm64)
else ()
	set(_ce_vcpkg_arch x64)
endif ()

set(_ce_triplet_dir "${CMAKE_BINARY_DIR}/vcpkg-triplets")
file(CONFIGURE OUTPUT "${_ce_triplet_dir}/${_ce_vcpkg_arch}-osx.cmake" CONTENT
"# Generated by Engine/CMake/CEMinimumMacOS.cmake - vcpkg's ${_ce_vcpkg_arch}-osx plus the engine's minimum macOS.
set(VCPKG_TARGET_ARCHITECTURE ${_ce_vcpkg_arch})
set(VCPKG_CRT_LINKAGE dynamic)
set(VCPKG_LIBRARY_LINKAGE static)

set(VCPKG_CMAKE_SYSTEM_NAME Darwin)
set(VCPKG_OSX_ARCHITECTURES ${_ce_vcpkg_arch})
set(VCPKG_OSX_DEPLOYMENT_TARGET \"${CMAKE_OSX_DEPLOYMENT_TARGET}\")
")

list(PREPEND VCPKG_OVERLAY_TRIPLETS "${_ce_triplet_dir}")
list(REMOVE_DUPLICATES VCPKG_OVERLAY_TRIPLETS)

unset(_ce_host_arch)
unset(_ce_vcpkg_arch)
unset(_ce_triplet_dir)
